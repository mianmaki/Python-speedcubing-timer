color_map = {
    'W': 'white',
    'Y': 'yellow',
    'G': 'green',
    'B': 'blue',
    'R': 'red',
    'O': 'orange'
}


def draw_cube(cube):
    canvas.delete("all")

    size = 20  # size of each sticker

    # positions for faces (U, D, F, B, R, L)
    offsets = {
        0: (size*3, 0),          # white (U)
        1: (size*3, size*6),     # yellow (D)
        2: (size*3, size*3),     # green (F)
        3: (size*9, size*3),     # blue (B)
        4: (size*6, size*3),     # red (R)
        5: (0, size*3)           # orange (L)
    }

    for face_index, face in enumerate(cube):
        x_offset, y_offset = offsets[face_index]

        for i, sticker in enumerate(face):
            row = i // 3
            col = i % 3

            x1 = x_offset + col * size
            y1 = y_offset + row * size
            x2 = x1 + size
            y2 = y1 + size

            canvas.create_rectangle(
                x1, y1, x2, y2,
                fill=color_map[sticker],
                outline='black'
            )


